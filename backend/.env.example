PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mdw-2026
# Lista de origenes permitidos, separados por comas.
# En development se aceptan ademas cualquier localhost o 127.0.0.1 en cualquier puerto.
CORS_ORIGIN=http://localhost:5173

# Genera un secret distinto para cada uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si quedan vacios el backend no arranca: es preferible a correr con un secret conocido.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
